# Database
# For local docker-compose: postgresql://atlas:atlas_local@localhost:5432/atlas
# For Neon production: postgresql://user:pass@host.neon.tech/dbname?sslmode=verify-full
DATABASE_URI=postgresql://atlas:atlas_local@localhost:5432/atlas

# Payload
PAYLOAD_SECRET=generate-a-random-32-char-string

# S3 storage (MinIO local / Cloudflare R2 production)
# For local docker-compose:
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=atlas-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# For Cloudflare R2 production:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto

# Public URL for media (browser-facing). Production must use the CDN —
# never the R2 API host (*.r2.cloudflarestorage.com).
# For local: http://localhost:9000/atlas-media
# For production: https://cdn.atlas-sinaloa.tech
MEDIA_URL=http://localhost:9000/atlas-media

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# better-auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostHog
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, not
# read at runtime — they must be present in the build environment or the client
# ships with them undefined and silently captures nothing.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Browser ingestion endpoint. Points at the shared Molécula reverse proxy so
# requests avoid the *.posthog.com domains that tracking blockers list.
# Set to https://us.i.posthog.com to bypass the proxy (e.g. while it is down).
NEXT_PUBLIC_POSTHOG_HOST=https://t.molecula.digital

# Where PostHog itself lives, for toolbar and "view in PostHog" links. Only
# matters when NEXT_PUBLIC_POSTHOG_HOST is a proxy; defaults to US cloud.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Server-side ingestion (route handlers). Goes direct — no blockers to evade
# server-side, and it avoids a pointless hop back through our own proxy.
POSTHOG_HOST=https://us.i.posthog.com
