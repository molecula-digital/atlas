# Database
# For local docker-compose: postgresql://atlas:atlas_local@localhost:5432/atlas
# For Neon production, use the `-pooler` hostname for runtime traffic.
DATABASE_URL=postgresql://atlas:atlas_local@localhost:5432/atlas
# Use Neon's non-pooled hostname for Drizzle and Payload migrations only.
DATABASE_DIRECT_URL=postgresql://atlas:atlas_local@localhost:5432/atlas

# Payload
PAYLOAD_SECRET=generate-a-random-32-char-string
PREVIEW_SECRET=generate-a-separate-random-32-char-string

# S3 storage (MinIO local / Cloudflare R2 production)
# For local docker-compose:
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=atlas-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# For Cloudflare R2 production:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto

# Public URL for media (browser-facing). Production must use the CDN —
# never the R2 API host (*.r2.cloudflarestorage.com).
# For local: http://localhost:9000/atlas-media
# For production: https://cdn.atlas-sinaloa.tech
MEDIA_URL=http://localhost:9000/atlas-media

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# better-auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Auth for POST /api/cron/luma-sync. Generate with: openssl rand -hex 32
CRON_SECRET=

# Cloudflare Workers (production)
# Local `pnpm dev` still uses Node + docker-compose. Workers preview:
#   cp .dev.vars.example .dev.vars   # then add the same secrets as .env
#   pnpm preview
#
# Production secrets live in the Cloudflare dashboard (Workers → Settings →
# Variables and Secrets), not in this file. Required runtime secrets:
#   DATABASE_URL (Neon -pooler hostname), PAYLOAD_SECRET, PREVIEW_SECRET,
#   BETTER_AUTH_SECRET, BETTER_AUTH_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#   S3_*, MEDIA_URL, NEXT_PUBLIC_SITE_URL, CRON_SECRET
# Build-time (inlined into the client): NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_SITE_URL must be present for the Workers/OpenNext
# build or Google sign-in falls back to localhost in the browser bundle.
# Optional: uncomment Hyperdrive in wrangler.jsonc after
#   wrangler hyperdrive create atlas-tech --connection-string="$DATABASE_URL"
