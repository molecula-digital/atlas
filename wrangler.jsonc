{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Connect-git Worker in the Cloudflare dashboard.
  // The npm package is still "atlas-tech"; do not reuse that as the script name.
  "name": "atlas",
  // cloudflare/worker.mjs re-exports the OpenNext fetch handler and adds cron.
  "main": "cloudflare/worker.mjs",
  "triggers": {
    // Keep-alive: every 3 minutes. cloudflare/worker.mjs scheduled() pings
    // Neon and warms the public pages so isolates and the DB do not sleep.
    // Luma: 00:00 and 12:00 UTC (5:00 AM and 5:00 PM America/Mazatlan).
    "crons": ["*/3 * * * *", "0 */12 * * *"],
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public",
  ],
  // Serve cacheable HTML (s-maxage) without running the Worker. Hits skip
  // isolate warmup entirely — the 8s TTFB. Admin/API send no-store and bypass.
  "cache": {
    "enabled": true,
  },
  // Run near Neon on cache misses instead of the eyeball colo.
  "placement": {
    "mode": "smart",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    // Next.js <Image> on Workers uses Cloudflare Image Resizing.
    "binding": "IMAGES",
  },
  // Self-bind the dashboard Worker (`atlas`), not package.json (`atlas-tech`).
  // Cloudflare Builds overrides `name` via WRANGLER_CI_OVERRIDE_NAME but does
  // not rewrite this field; cloudflare/pin-name.mjs keeps them aligned.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "atlas",
    },
  ],
  // OpenNext ISR / fetch cache. Without this bucket every HTML request SSRs
  // against Neon even when Next sends x-nextjs-prerender.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "atlas-tech-next-cache",
    },
  ],
  // Dedupes ISR revalidation (queue) and stores on-demand revalidatePath/Tag.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  // Optional: lower-latency Postgres from Workers. Create with:
  //   wrangler hyperdrive create atlas-tech --connection-string="$DATABASE_URL"
  // then paste the id here. Runtime still works with the DATABASE_URL secret alone
  // (use Neon’s `-pooler` hostname).
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "YOUR_HYPERDRIVE_ID",
  //     "localConnectionString": "postgresql://atlas:atlas_local@localhost:5432/atlas",
  //   },
  // ],
  // Keep the Worker script under the 10 MiB gzip paid cap.
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "alias": {
    // Next.js image-optimizer requires sharp; native libvips cannot run in workerd.
    "sharp": "./cloudflare/stubs/empty-sharp.js",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  // Headroom for /api/cron/luma-sync (network-bound; default paid CPU is 30s).
  "limits": {
    "cpu_ms": 60000,
  },
}
