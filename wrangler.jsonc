{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Connect-git Worker in the Cloudflare dashboard.
  // The npm package is still "atlas-tech"; do not reuse that as the script name.
  "name": "atlas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    // Next.js <Image> on Workers uses Cloudflare Image Resizing.
    "binding": "IMAGES",
  },
  // Self-bind the dashboard Worker (`atlas`), not package.json (`atlas-tech`).
  // Cloudflare Builds overrides `name` via WRANGLER_CI_OVERRIDE_NAME but does
  // not rewrite this field; scripts/pin-cf-worker-name.mjs keeps them aligned.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "atlas",
    },
  ],
  // Optional: uncomment after creating the bucket (`wrangler r2 bucket create atlas-tech-next-cache`)
  // and an incremental cache will back ISR / fetch cache. Without it, pages SSR on each request.
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "atlas-tech-next-cache",
  //   },
  // ],
  // Optional: lower-latency Postgres from Workers. Create with:
  //   wrangler hyperdrive create atlas-tech --connection-string="$DATABASE_URL"
  // then paste the id here. Runtime still works with the DATABASE_URL secret alone
  // (use Neon’s `-pooler` hostname).
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "YOUR_HYPERDRIVE_ID",
  //     "localConnectionString": "postgresql://atlas:atlas_local@localhost:5432/atlas",
  //   },
  // ],
  // Keep the Worker script under the 10 MiB gzip paid cap.
  "minify": true,
  "keep_names": false,
  "upload_source_maps": false,
  "observability": {
    "enabled": true,
  },
  // Headroom for /api/cron/luma-sync (network-bound; default paid CPU is 30s).
  "limits": {
    "cpu_ms": 60000,
  },
}
